<?xml version="1.0" encoding="utf-8"?>
<!-- Signup step 2: the code sent by WhatsApp. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tpp_bg"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/tpp_back_header" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="8dp"
                android:paddingEnd="24dp">

                <TextView
                    style="@style/TppText.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tpp_code_title" />

                <TextView
                    android:id="@+id/body"
                    style="@style/TppText.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.3" />

                <EditText
                    android:id="@+id/code"
                    style="@style/TppText.Bold"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:autofillHints="smsOTPCode"
                    android:background="@drawable/tpp_bg_card"
                    android:gravity="center"
                    android:hint="@string/tpp_code_hint"
                    android:inputType="number"
                    android:letterSpacing="0.3"
                    android:digits="0123456789 -"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/confirm"
                    style="@style/TppText.Bold"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/tpp_bg_button_brand"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/tpp_code_confirm"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/message"
                    style="@style/TppText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/tpp_brand"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/fallbackIntro"
                style="@style/TppText.SemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/tpp_code_fallback_intro"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/resend"
                style="@style/TppText.Bold"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/tpp_bg_button_outline"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/tpp_code_resend"
                android:textColor="@color/tpp_brand_dark"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/fallbackOr"
                style="@style/TppText.SemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="16dp"
                android:text="@string/tpp_code_fallback_or"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/help"
                style="@style/TppText.Bold"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/tpp_bg_button_whatsapp"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/tpp_signup_help"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</layout>
