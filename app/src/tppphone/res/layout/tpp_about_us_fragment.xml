<?xml version="1.0" encoding="utf-8"?>
<!-- "Sobre nosotros": company, prepaid card shop, and the legal notices in small print. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tpp_bg"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/tpp_back_header" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="TPP Phone"
                    android:src="@drawable/tpp_logo_phone" />

                <TextView
                    style="@style/TppText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/tpp_about_us_body"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/tpp_bg_card"
                    android:orientation="vertical"
                    android:padding="1dp">

                    <include
                        android:id="@+id/shop"
                        layout="@layout/tpp_menu_row" />
                </LinearLayout>

                <TextView
                    android:id="@+id/phones"
                    style="@style/TppText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingMultiplier="1.25"
                    android:textColorLink="@color/tpp_brand_dark"
                    android:textSize="13sp" />

                <!-- Small print -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="32dp"
                    android:background="@color/tpp_border" />


                <TextView
                    android:id="@+id/source"
                    style="@style/TppText.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/tpp_about_us_source"
                    android:textColor="@color/tpp_brand_dark"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/terms"
                    style="@style/TppText.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/tpp_terms_title"
                    android:textColor="@color/tpp_brand_dark"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/licenses"
                    style="@style/TppText.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/tpp_licenses_title"
                    android:textColor="@color/tpp_brand_dark"
                    android:textSize="12sp" />

                <TextView
                    style="@style/TppText.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/tpp_about_us_copyright"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
