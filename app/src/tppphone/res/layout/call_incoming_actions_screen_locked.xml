<?xml version="1.0" encoding="utf-8"?>
<!-- tppphone override: vertical track. Swipe the green button up to answer, down to decline
     (SwipeUpToAnswer). Keeps Linphone's ids; sliding_button still answers on an accessibility click. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="org.linphone.ui.call.viewmodel.CurrentCallViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sliding_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/answer_label"
            style="@style/TppText.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tpp_call_swipe_hint"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/tpp_swipe_hint"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/tpp_swipe_chevron_up"
            app:layout_constraintBottom_toTopOf="@id/sliding_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/sliding_button"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/tpp_swipe_answer_button"
            android:contentDescription="@string/tpp_call_answer"
            android:elevation="6dp"
            android:onClick="@{() -> viewModel.answer()}"
            android:padding="22dp"
            android:src="@drawable/phone"
            app:layout_constraintBottom_toTopOf="@id/decline_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/decline_label"
            style="@style/TppText.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:onClick="@{() -> viewModel.hangUp()}"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="@string/tpp_call_decline"
            android:textColor="@color/tpp_call_decline"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
