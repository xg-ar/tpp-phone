<?xml version="1.0" encoding="utf-8"?>
<!-- About, licenses moved to "Sobre nosotros". -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="versionText"
            type="String" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tpp_bg"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/tpp_back_header" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/tpp_bg_app_icon">

                    <ImageView
                        android:layout_width="62dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/tpp_logo_white" />
                </FrameLayout>

                <TextView
                    style="@style/TppText.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:text="@string/app_name"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/version_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:gravity="center"
                    android:text="@{versionText}"
                    android:textColor="@color/tpp_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/tpp_bg_card"
                    android:orientation="vertical"
                    android:padding="1dp">

                    <include
                        android:id="@+id/check"
                        layout="@layout/tpp_menu_row" />

                    <include
                        android:id="@+id/email"
                        layout="@layout/tpp_menu_row" />

                    <include
                        android:id="@+id/privacy"
                        layout="@layout/tpp_menu_row" />

                    <include
                        android:id="@+id/about_us"
                        layout="@layout/tpp_menu_row" />
                </LinearLayout>

                <TextView
                    android:id="@+id/delete_account"
                    style="@style/TppText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:text="@string/tpp_delete_link"
                    android:textColor="@color/tpp_problem_title"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
