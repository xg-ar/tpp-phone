<?xml version="1.0" encoding="utf-8"?>
<!-- The line was activated on another phone. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tpp_bg"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/tpp_back_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/tpp_ic_alert_circle"
                android:tint="@color/tpp_problem_title" />

            <TextView
                style="@style/TppText.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/tpp_line_moved_title" />

            <TextView
                style="@style/TppText.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/tpp_line_moved_body"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/activate"
            style="@style/TppText.Bold"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/tpp_bg_button_brand"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/tpp_line_moved_activate"
            android:textColor="@android:color/white"
            android:textSize="15sp" />
    </LinearLayout>
</layout>
