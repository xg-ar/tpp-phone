<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- XG: permissions TPP Phone (receive-only) does not use; the main manifest keeps them for other builds.
         CAMERA and FOREGROUND_SERVICE_CAMERA stay on purpose (video calls, in development).
         READ_CONTACTS stays too: optional, asked from a discreet link on the home screen (contact names), never a requirement. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />

    <!-- Problem screen: vendor autostart settings (DeviceSettings.manufacturerAutostart). -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oplus.safecenter" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.huawei.systemmanager" />
    </queries>

    <!-- No backup: see res/xml/data_extraction_rules.xml (this covers Android 11 and older). -->
    <application
        android:allowBackup="false"
        tools:replace="android:allowBackup">
        <!-- XG: prov's "Nuevo mensaje de voz" push is a notification message: with the app in
             the background the Firebase SDK shows it itself, with these defaults. Without the icon it
             would show the app's colour launcher icon as a white square. The call pushes from Flexisip
             are data-only and handled by Linphone's FirebaseMessaging service, which never builds a
             notification, so these do not touch them. prov already sets channel_id; the default
             channel only covers a push without it. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/linphone_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/tpp_brand" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tpp_voice_messages" />
        <activity
            android:name="ar.com.tpp.phone.ui.TppMainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TppPhone"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- XG: CorePushService (dataSync) stays: the Linphone SDK starts it itself when a push arrives.
             The file transfer service (chat) and the keep-alive service (never on) are unused. -->
        <service android:name="org.linphone.core.CoreFileTransferService" tools:node="remove" />
        <service android:name="org.linphone.core.CoreKeepAliveThirdPartyAccountsService" tools:node="remove" />

        <!-- Receive-only app: Linphone's main activity is not a launcher, dialer or share target.
             It stays declared because notifications and CallActivity open it; it forwards to
             TppMainActivity (BuildConfig.TPP_UI). -->
        <activity
            android:name="org.linphone.ui.main.MainActivity"
            android:exported="false"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
            <meta-data
                android:name="android.app.shortcuts"
                tools:node="remove" />
        </activity>
    </application>
</manifest>
